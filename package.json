{
  "author": "kannkyo",
  "bin": {
    "e-gov-law-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/kannkyo/e-gov-law-mcp",
  "name": "e-gov-law-mcp-server",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --sourcemap",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.1.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
